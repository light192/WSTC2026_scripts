! Apply on DC2 for D1 Day 2 matched faults
configure terminal
!
! T08: DC-LNX01 backup job to Cloud DC fails; local DC connectivity remains healthy.
ip access-list extended D1-T08-DC-BACKUP-BLOCK
 remark T08 - block backup protocols from DC-LNX01 to cloud backup loopback only
 deny tcp host 10.19.110.11 host 10.19.220.1 eq 22
 deny tcp host 10.19.110.11 host 10.19.220.1 eq 873
 permit ip any any
exit
interface GigabitEthernet0/1
 ip access-group D1-T08-DC-BACKUP-BLOCK in
exit
end
write memory
