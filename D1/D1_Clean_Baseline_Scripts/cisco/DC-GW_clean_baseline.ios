!
! Чистая базовая конфигурация D1. Примените к устройству, указанному в строке hostname.
! ВАЖНО: перед вставкой сверьте имена интерфейсов с топологией PNETLab.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name d1.skills
crypto key generate rsa modulus 2048
!

hostname DC-GW
!
interface GigabitEthernet0/0
 description TO-Internet-Gi0/2
 ip address 172.19.0.10 255.255.255.252
 ip ospf cost 100
 no shutdown
!
interface GigabitEthernet0/1
 description TO-MPLS-Gi0/2
 ip address 10.255.19.10 255.255.255.252
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet0/2
 description TRUNK-TO-DC-Switch-Gi0/0
 no ip address
 no shutdown
!
interface GigabitEthernet0/2.110
 encapsulation dot1Q 110
 description DC_SERVERS_GW
 ip address 10.19.110.1 255.255.255.0
!
interface GigabitEthernet0/2.120
 encapsulation dot1Q 120
 description DC_CLIENTS_GW
 ip address 10.19.120.1 255.255.255.0
!
interface GigabitEthernet0/2.99
 encapsulation dot1Q 99
 description DC_MGMT_GW
 ip address 10.19.199.1 255.255.255.0
!
router ospf 39
 router-id 5.5.5.5
 passive-interface default
 no passive-interface GigabitEthernet0/0
 no passive-interface GigabitEthernet0/1
 no passive-interface GigabitEthernet0/2
 no passive-interface GigabitEthernet0/3
 no passive-interface GigabitEthernet0/4
 network 0.0.0.0 255.255.255.255 area 0
!
end
write memory
