!
! Чистая базовая конфигурация D1. Примените к устройству, указанному в строке hostname.
! ВАЖНО: перед вставкой сверьте имена интерфейсов с топологией PNETLab.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name d1.skills
crypto key generate rsa modulus 2048
!

hostname HQ-SW-D
!
! В чистой базовой конфигурации это устройство используется как коммутатор уровня 3.
! Если образ поддерживает только уровень 2, вручную замените эту конфигурацию схемой access/trunk.
ip routing
!
interface GigabitEthernet0/0
 description TO-HQ-GW2-Gi0/3
 no switchport
 ip address 10.19.40.14 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/1
 description TO-HQ-GW1-Gi0/4
 no switchport
 ip address 10.19.40.10 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-R-Gi0/0
 no switchport
 ip address 10.19.40.1 255.255.255.252
 no shutdown
!
interface GigabitEthernet0/3
 description TO-HQ-R-Gi0/1
 no switchport
 ip address 10.19.40.5 255.255.255.252
 no shutdown
!
router ospf 39
 router-id 3.3.3.3
 passive-interface default
 no passive-interface GigabitEthernet0/0
 no passive-interface GigabitEthernet0/1
 no passive-interface GigabitEthernet0/2
 no passive-interface GigabitEthernet0/3
 no passive-interface GigabitEthernet0/4
 network 0.0.0.0 255.255.255.255 area 0
!
end
write memory
