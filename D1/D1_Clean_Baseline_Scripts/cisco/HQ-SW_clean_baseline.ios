!
! Чистая базовая конфигурация D1. Примените к устройству, указанному в строке hostname.
! ВАЖНО: перед вставкой сверьте имена интерфейсов с топологией PNETLab.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name d1.skills
crypto key generate rsa modulus 2048
!

hostname HQ-SW
!
spanning-tree mode rapid-pvst
vlan 10
 name HQ_USERS
vlan 20
 name HQ_SERVERS
vlan 99
 name HQ_MGMT
!
interface GigabitEthernet0/0
 description TRUNK-TO-HQ-GW1-Gi0/3
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99
 no shutdown
!
interface GigabitEthernet0/1
 description TRUNK-TO-HQ-GW2-Gi0/4
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-LNX01-e0
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
!
interface GigabitEthernet0/3
 description TO-HQ-FILE01-e0
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
!
interface GigabitEthernet1/0
 description TO-HQ-AD01-e0
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
!
interface GigabitEthernet1/1
 description TO-HQ-WS01-e0
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
!
interface Vlan99
 description HQ-SW-MGMT
 ip address 10.19.99.11 255.255.255.0
 no shutdown
!
ip default-gateway 10.19.99.1
end
write memory
