!
! D1 clean baseline. Apply to the device named in the hostname line.
! IMPORTANT: verify interface names against the PNETLab topology before pasting.
! L3 distribution switch. Gi0/0/Gi0/1 uplinks to the gateways are trunks per
! the taskbook topology but currently carry no active host VLANs - see
! docs/ADDRESSING_NOTES.md. Gi0/2/Gi0/3 are routed links to HQ-R.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
ip routing
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name skill39.d1
crypto key generate rsa modulus 2048
!

hostname HQ-SW-D
!
interface GigabitEthernet0/0
 description TRUNK-TO-HQ-GW2-Gi0/3-reserved-no-active-VLANs
 switchport mode trunk
 switchport trunk allowed vlan none
 no shutdown
!
interface GigabitEthernet0/1
 description TRUNK-TO-HQ-GW1-Gi0/4-reserved-no-active-VLANs
 switchport mode trunk
 switchport trunk allowed vlan none
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-R-Gi0/0-routed
 no switchport
 ip address 10.19.30.5 255.255.255.252
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet0/3
 description TO-HQ-R-Gi0/1-routed
 no switchport
 ip address 10.19.30.1 255.255.255.252
 ip ospf cost 10
 no shutdown
!
router ospf 39
 router-id 40.40.40.13
 passive-interface default
 no passive-interface GigabitEthernet0/2
 no passive-interface GigabitEthernet0/3
 network 0.0.0.0 255.255.255.255 area 0
!
end
write memory
