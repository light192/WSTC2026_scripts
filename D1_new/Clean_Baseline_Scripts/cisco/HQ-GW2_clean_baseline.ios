!
! D1 clean baseline. Apply to the device named in the hostname line.
! IMPORTANT: verify interface names against the PNETLab topology before pasting.
! Backup HQ gateway. Lower HSRP priority + Gi0/0 tracking; preempts HQ-GW1
! automatically once HQ-GW1's Internet uplink (and therefore its priority) drops.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name skill39.d1
crypto key generate rsa modulus 2048
!

hostname HQ-GW2
!
interface GigabitEthernet0/0
 description TO-Internet-Gi0/4
 ip address 10.202.0.10 255.255.255.252
 ip ospf cost 100
 no shutdown
!
interface GigabitEthernet0/1
 description TO-MPLS-Gi0/1
 ip address 10.203.0.10 255.255.255.252
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-GW1-Gi0/2
 ip address 10.19.255.2 255.255.255.252
 ip ospf cost 5
 no shutdown
!
interface GigabitEthernet0/3
 description TRUNK-TO-HQ-SW-D-Gi0/0-no-active-host-VLANs
 no ip address
 no shutdown
!
interface GigabitEthernet0/4
 description TRUNK-TO-HQ-SW-Gi0/1
 no ip address
 no shutdown
!
interface GigabitEthernet0/4.10
 encapsulation dot1Q 10
 description HQ_USERS_GW
 ip address 10.19.10.3 255.255.255.0
 standby 10 ip 10.19.10.1
 standby 10 priority 100
 standby 10 preempt
 standby 10 track GigabitEthernet0/0 decrement 20
!
interface GigabitEthernet0/4.20
 encapsulation dot1Q 20
 description HQ_SERVERS_GW
 ip address 10.19.20.3 255.255.255.0
 standby 20 ip 10.19.20.1
 standby 20 priority 100
 standby 20 preempt
 standby 20 track GigabitEthernet0/0 decrement 20
!
router ospf 39
 router-id 40.40.40.2
 passive-interface default
 no passive-interface GigabitEthernet0/0
 no passive-interface GigabitEthernet0/1
 no passive-interface GigabitEthernet0/2
 no passive-interface GigabitEthernet0/4.10
 no passive-interface GigabitEthernet0/4.20
 network 0.0.0.0 255.255.255.255 area 0
!
end
write memory
