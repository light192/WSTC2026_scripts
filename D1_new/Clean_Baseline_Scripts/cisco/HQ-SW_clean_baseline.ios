!
! D1 clean baseline. Apply to the device named in the hostname line.
! IMPORTANT: verify interface names against the PNETLab topology before pasting.
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name skill39.d1
crypto key generate rsa modulus 2048
!

hostname HQ-SW
!
vlan 10
 name HQ_USERS
!
vlan 20
 name HQ_SERVERS
!
interface GigabitEthernet0/0
 description TRUNK-TO-HQ-GW1-Gi0/3
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
!
interface GigabitEthernet0/1
 description TRUNK-TO-HQ-GW2-Gi0/4
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-LNX01-e0
 switchport mode access
 switchport access vlan 20
 no shutdown
!
interface GigabitEthernet0/3
 description TO-HQ-FILE01-e0
 switchport mode access
 switchport access vlan 20
 no shutdown
!
interface GigabitEthernet1/0
 description TO-HQ-AD01-e0
 switchport mode access
 switchport access vlan 20
 no shutdown
!
interface GigabitEthernet1/1
 description TO-HQ-WS01-e0
 switchport mode access
 switchport access vlan 10
 no shutdown
!
end
write memory
