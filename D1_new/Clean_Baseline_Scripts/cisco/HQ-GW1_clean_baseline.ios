!
! D1 clean baseline. Apply to the device named in the hostname line.
! IMPORTANT: verify interface names against the PNETLab topology before pasting.
! Primary HQ gateway. HSRP priority 110 + Gi0/0 tracking so HQ-GW2 can
! preempt automatically if the Internet uplink on HQ-GW1 goes down (T06).
no ip domain lookup
service timestamps debug datetime msec
service timestamps log datetime msec
ip cef
username expert privilege 15 secret Skill39@D1
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 login local
 transport input ssh telnet
ip domain-name skill39.d1
crypto key generate rsa modulus 2048
!

hostname HQ-GW1
!
track 1 interface GigabitEthernet0/0 line-protocol
!
interface GigabitEthernet0/0
 description TO-Internet-Gi0/3
 ip address 10.202.0.6 255.255.255.252
 ip ospf cost 100
 no shutdown
!
interface GigabitEthernet0/1
 description TO-MPLS-Gi0/0
 ip address 10.203.0.6 255.255.255.252
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet0/2
 description TO-HQ-GW2-Gi0/2
 ip address 10.19.255.1 255.255.255.252
 ip ospf cost 5
 no shutdown
!
interface GigabitEthernet0/3
 description TRUNK-TO-HQ-SW-Gi0/0
 no ip address
 no shutdown
!
interface GigabitEthernet0/3.10
 encapsulation dot1Q 10
 description HQ_USERS_GW
 ip address 10.19.10.2 255.255.255.0
 standby 10 ip 10.19.10.1
 standby 10 priority 110
 standby 10 preempt
 standby 10 track 1 decrement 20
!
interface GigabitEthernet0/3.20
 encapsulation dot1Q 20
 description HQ_SERVERS_GW
 ip address 10.19.20.2 255.255.255.0
 standby 20 ip 10.19.20.1
 standby 20 priority 110
 standby 20 preempt
 standby 20 track 1 decrement 20
!
interface GigabitEthernet0/4
 description TRUNK-TO-HQ-SW-D-Gi0/1-no-active-host-VLANs
 no ip address
 no shutdown
!
router ospf 39
 router-id 40.40.40.1
 passive-interface default
 no passive-interface GigabitEthernet0/0
 no passive-interface GigabitEthernet0/1
 no passive-interface GigabitEthernet0/2
 no passive-interface GigabitEthernet0/3.10
 no passive-interface GigabitEthernet0/3.20
 network 0.0.0.0 255.255.255.255 area 0
!
end
write memory
